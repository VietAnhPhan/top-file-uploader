<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=title %>
    </title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

    <% if (locals.user) {%>
        <header>
            <ul>
                <div class="header__brand">
                    <h1><a href="/">Welcome to cloud storage!</a></h1>
                </div>
                <div class="header__account">
                    <ul>
                        <% if(locals.user) { %>
                            <li>Hello, <%=user.user_name%>
                                    <%=user.membership_status %></a></li>
                            <li><a href="/log-out">Log out</a></li>
                            <% } else {%>
                                <li><a href="/log-in">Log in</a></li>
                                <li><a href="/sign-up">Sign up</a></li>
                                <% } %>
                    </ul>
                </div>

            </ul>
        </header>
        <main class="container">
            <div class="main_actions">
                <form action="/upload" method="post" enctype="multipart/form-data">
                    <input type="file" name="file_upload" />
                    <button type="submit">Upload files</button>
                </form>

                <div>
                    <dialog class="dialog__create_folder">
                        <form action="/folders/create" method="post">
                            <input type="text" name="folder_name" placeholder="Untitled folder">
                            <button type="submit">Create folder</button>
                        </form>
                    </dialog>
                    <button class="btn__new_folder">New folder</button>
                </div>
            </div>
            <div class="resources">

                <% if(locals.file) {%>


                    <div class="file__description">
                        <p class="resource__title">
                            File name: <%=file.name %>
                        </p>
                        <p class="resource__uploaded_at">
                            Uploaded at: <%=file.created_at %>
                        </p>
                        <p class="resource__file_size">
                            Size: <%=file.size %> byte
                        </p>
                        <p class="resource__download_btn">
                            <% const filePath=file.path.replace("public","static") %>
                                <a href="/<%=filePath%>" download>Download file</a>
                        </p>
                    </div>

                    <% }; %>


            </div>
        </main>
        <%} else{%>

            <main class="container">
                <div class="content__wrapper_col">
                    <div class="content__title_login">
                        <h1>Save your personal files here...</h1>
                        <h3>Hundred thoundsand people use...</h3>
                    </div>
                    <div class="form__submit form__submit_login">
                        <form action="/log-in" method="post">
                            <label for="user_name">User name: </label>
                            <input type="text" id="user_name" name="user_name" required>
                            <label for="password">Password name: </label>
                            <input type="password" id="password" name="password" required>
                            <button type="submit">Login now</button>

                        </form>
                        <p>Or</p>

                        <a href="/sign-up">Register now</a>
                    </div>
                </div>
            </main>
            <%}%>
                <script src="/static/index.js"></script>
</body>

</html>