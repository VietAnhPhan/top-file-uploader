<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%=title %>
    </title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

    <% if (locals.user) {%>
        <header>
            <ul>
                <div class="header__brand">
                    <h1><a href="/">Welcome to cloud storage!</a></h1>
                </div>
                <div class="header__account">
                    <ul>
                        <% if(locals.user) { %>
                            <li>Hello, <%=user.user_name%>
                            </li>
                            <li><a href="/log-out">Log out</a></li>
                            <% } else {%>
                                <li><a href="/log-in">Log in</a></li>
                                <li><a href="/sign-up">Sign up</a></li>
                                <% } %>
                    </ul>
                </div>

            </ul>
        </header>
        <main class="container">
            <div class="main_actions">
                <form action="/upload" method="post" enctype="multipart/form-data">
                    <input type="file" name="file_upload" />
                    <button type="submit">Upload files</button>
                </form>

                <div>
                    <dialog class="dialog__create_folder">
                        <form action="/folders/create" method="post">
                            <input type="text" name="folder_name" placeholder="Untitled folder">
                            <button type="submit">Create folder</button>
                        </form>
                    </dialog>
                    <button class="btn__new_folder">New folder</button>
                </div>
            </div>
            <div class="resources">


                <% if(locals.folders) {%>
                    <ul class="folders">
                        <% locals.folders.forEach(folder=> { %>
                            <li class="folder">
                                <div class="folder__wrapper">
                                    <div class="folder__description">
                                        <p class="resource__title">
                                            <%=folder.name %>
                                        </p>
                                        <p class="resource__uploaded_at">
                                            <%=folder.created_at %>
                                        </p>

                                    </div>
                                    <div class="folder__actions">


                                        <form action="/folders/delete" method="post">
                                            <input type="hidden" name="folder_id" value="<%=folder.id%>">
                                            <input type="hidden" name="folder_name" value="<%=folder.name%>">
                                            <button type="submit">Delete</button>
                                        </form>
                                        <dialog class="dialog__edit_folder">
                                            <p>Edit folder</p>

                                            <form action="/folders/edit" method="post" class="form__edit">
                                                <input type="hidden" name="folder_id" value="<%=folder.id%>">
                                                <input type="hidden" name="folder_old_name" value="<%=folder.name%>">

                                                <input type="text" name="folder_new_name"
                                                    placeholder="<%=folder.name%>">
                                                <div class="form__buttons">
                                                    <button type="button" class="btn__close_dialog">Cancel</button>
                                                    <button type="submit">Save folder</button>
                                                </div>
                                            </form>

                                        </dialog>
                                        <button class="btn__edit_folder">Edit</button>
                                        <dialog class="dialog__upload_files">
                                            <form action="/upload" method="post" enctype="multipart/form-data">
                                                <input type="hidden" name="folder_id" value="<%=folder.id%>">
                                                <input type="file" name="file_upload" />
                                                <button type="submit">Upload files</button>
                                            </form>
                                        </dialog>
                                        <button class="btn__upload_files">Upload files</button>

                                    </div>
                                </div>
                                <ul class="files__in_folder">


                                    <% folder.file.forEach(file=>{ %>
                                        <%- include("fileItem", { file:file }) %>
                                            <% }) %>
                                </ul>
                            </li>
                            <% }); %>
                    </ul>
                    <% } %>


                        <% if(locals.files) {%>
                            <ul class="files">
                                <% locals.files.forEach(file=> { %>
                                    <%- include("fileItem", { file:file }) %>
                                        <% }); %>
                            </ul>
                            <% } %>

            </div>
        </main>
        <%} else{%>

            <main class="container">
                <div class="content__wrapper_col">
                    <div class="content__title_login">
                        <h1>Save your personal files here...</h1>
                        <h3>Hundred thoundsand people use...</h3>
                    </div>
                    <div class="form__submit form__submit_login">
                        <form action="/log-in" method="post">
                            <label for="user_name">User name: </label>
                            <input type="text" id="user_name" name="user_name" required>
                            <label for="password">Password name: </label>
                            <input type="password" id="password" name="password" required>
                            <button type="submit">Login now</button>

                        </form>
                        <p>Or</p>

                        <a href="/sign-up">Register now</a>
                    </div>
                </div>
            </main>
            <%}%>
                <script src="/static/index.js"></script>
</body>

</html>